{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starmap.local/schemas/want-to-go.schema.json",
  "title": "StarMap Want To Go Data",
  "type": "object",
  "required": ["schema_version", "generated_at", "privacy_level", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "privacy_level": {
      "enum": ["public-sample", "local-only"]
    },
    "intended_use": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "place", "addedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^wtg_\\S+$" },
        "place": { "$ref": "#/$defs/place" },
        "note": { "type": "string", "maxLength": 200 },
        "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hidden": { "type": "boolean", "default": false },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": ["kind", "nameZh", "nameEn", "countryCode"],
      "properties": {
        "kind": { "enum": ["city", "country"] },
        "nameZh": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "dependentRequired": {
        "lat": ["lng"],
        "lng": ["lat"]
      },
      "additionalProperties": false
    }
  }
}
